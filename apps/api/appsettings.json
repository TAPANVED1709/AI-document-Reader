{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,14333;Database=AiDocumentReaderDb;User Id=sa;Password=__SET_VIA_ENVIRONMENT__;TrustServerCertificate=True;Connect Timeout=5;"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Storage": {
    "ReportsPath": "storage/reports"
  },
  "Processing": {
    "MaxConcurrentJobs": 2,
    "MaxDurationSeconds": 300,
    "StaleJobSeconds": 600,
    "MaxPdfPages": 50
  },
  "Ollama": {
    "MaxConcurrentRequests": 2
  }
}
